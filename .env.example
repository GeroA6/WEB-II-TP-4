# Dirección de escucha (0.0.0.0 permite conexiones desde otros dispositivos en la misma red local)
HOST=0.0.0.0

# Puerto único donde corre el servidor (HTTP + WebSocket + SSE)
PORT=3000

# URL base del catálogo externo (DummyJSON)
CATALOG_URL=https://dummyjson.com/products

# Tiempo máximo de espera (en milisegundos) por cada consulta al catálogo
CATALOG_TIMEOUT_MS=3000

# Demora artificial opcional (en milisegundos) enviada a DummyJSON (?delay=...)
# Útil para simular un catálogo lento sin modificar el código (0 = sin demora)
CATALOG_DELAY_MS=0
